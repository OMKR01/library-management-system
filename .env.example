# =============================================================
# Library Management System - Global Environment Variables Template
# Copy this file to `.env` in `server/` and `server/src/` and fill in your Supabase credentials.
# NOTE: Never commit your actual `.env` file containing passwords to GitHub!
# =============================================================

# -------------------------------------------------------------
# Server & Database (Supabase PostgreSQL)
# -------------------------------------------------------------

# Port for the Node/Express backend server
PORT=5000

# Transaction-mode connection pooler URL (IPv4 / pgbouncer, port 6543)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode connection pooler URL (Direct connection for Prisma migrations, port 5432)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------
# Client (Optional / Production Frontend)
# -------------------------------------------------------------
# In local development, Vite proxies `/api` to http://localhost:5000
# For production deployment (e.g. Vercel/Netlify), specify your hosted backend API URL:
VITE_API_BASE_URL="http://localhost:5000/api"
