# -------------------------------------------------------------
# LMS Client - Environment Variables Template
# -------------------------------------------------------------

# For local development with Vite proxy, leave empty or use:
# VITE_API_BASE_URL=/api

# For production deployment on Vercel:
# Set this to your deployed backend API URL (including /api path):
# Example: https://library-management-api.vercel.app/api
VITE_API_BASE_URL=
